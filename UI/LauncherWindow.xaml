<Window x:Class="WinToMac.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="winToMac"
        Width="900" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Menu.Foreground}">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Border">
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="16" Padding="24,20,24,16"
            Background="{DynamicResource Menu.Background}"
            BorderBrush="{DynamicResource Menu.Separator}" BorderThickness="0.8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" />
        </Border.Effect>
        <DockPanel>
            <!-- Поиск и переключатель «Все / Избранное» -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border x:Name="AllTab" Style="{StaticResource TabButton}" MouseLeftButtonUp="OnAllTabClick">
                        <TextBlock x:Name="AllTabText" FontSize="13" />
                    </Border>
                    <Border x:Name="FavoritesTab" Style="{StaticResource TabButton}" MouseLeftButtonUp="OnFavoritesTabClick">
                        <TextBlock x:Name="FavoritesTabText" FontSize="13" />
                    </Border>
                </StackPanel>
                <Border CornerRadius="8" Padding="10,0" Height="34" Margin="0,0,16,0"
                        Background="#22808080" BorderBrush="{DynamicResource Menu.Separator}" BorderThickness="0.5">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Menu.Secondary}" />
                        <TextBlock x:Name="SearchPlaceholder" Margin="24,0,0,0" FontSize="14"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Menu.Secondary}" />
                        <TextBox x:Name="SearchBox" Margin="22,0,0,0" FontSize="14" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Menu.Foreground}"
                                 CaretBrush="{DynamicResource Menu.Foreground}"
                                 TextChanged="OnSearchChanged" />
                    </Grid>
                </Border>
            </DockPanel>

            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="11.5" Margin="0,10,0,0"
                       Foreground="{DynamicResource Menu.Secondary}"
                       />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <WrapPanel x:Name="TilesPanel" />
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" Margin="0,60,0,0" FontSize="14"
                               Foreground="{DynamicResource Menu.Secondary}" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
