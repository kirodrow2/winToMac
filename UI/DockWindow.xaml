<Window x:Class="WinToMac.UI.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="winToMac Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        FontFamily="{StaticResource UiFont}">
    <!-- Окно во всю ширину экрана и с запасом по высоте под увеличенные иконки;
         полностью прозрачные пиксели пропускают клики к окнам под доком -->
    <Grid x:Name="Root">
        <Grid x:Name="DockArea" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              MouseRightButtonUp="OnDockBackgroundRightClick">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HideTransform" />
            </Grid.RenderTransform>
            <Border x:Name="DockBackground" VerticalAlignment="Bottom"
                    Background="{DynamicResource Panel.Background}"
                    BorderBrush="{DynamicResource Panel.Border}"
                    BorderThickness="0.8" />
            <StackPanel x:Name="ItemsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
        </Grid>
        <Canvas x:Name="LabelLayer" IsHitTestVisible="False">
            <Border x:Name="Label" CornerRadius="6" Padding="10,4" Visibility="Collapsed"
                    Background="{DynamicResource Label.Background}"
                    BorderBrush="{DynamicResource Menu.Separator}" BorderThickness="0.5">
                <TextBlock x:Name="LabelText" FontSize="13" Foreground="{DynamicResource Menu.Foreground}" />
            </Border>
        </Canvas>
    </Grid>
</Window>
